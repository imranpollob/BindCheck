":{\"kind\":\"dev\",\"methods\":{\"settle(uint256[9])\":{\"params\":{\"messages\":\"The 9-word public output from the producer circuit.\"},\"returns\":{\"result\":\"The settlement outcome.\"}}},\"title\":\"SynthSettlement \\u2014 authored D1-04 baseline consumer\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"settle(uint256[9])\":{\"notice\":\"Settle a batch of records from the public message array.\"}},\"notice\":\"Models the same N=9, 3-word record grammar as the synthetic producer.         NOT derived from any third-party contract. Record format: [kind, a, b] where kind 0=pad/end, 2=mint, 3=burn. Records are processed in order; the first pad record ends the active stream. A burn transfers `a` tokens to address `b`. A mint registers asset `a`. This contract does NOT verify a real proof. It accepts a mock \\\"proof valid\\\" flag for baseline testing only. The actual proof/verification boundary is assumption A6 in the research contract.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"cases/d1/synth/contracts/SynthSettlement.sol\":\"SynthSettlement\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"cases/d1/synth/contracts/SynthSettlement.sol\":{\"keccak256\":\"0x4a8a4ca7a0246a5075507f1e7bbb0b037211d1234aa6fa85edc0698975ea6ab1\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://0f5acada0eae4ed3454250ca851495c11bf3e129d043c834b9f6e312f86fe7dc\",\"dweb:/ipfs/QmSjveg6aZpjTfDkZXy1UbVstA5uaWDubVx36JjkmHeFKa\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.20+commit.a1b79de6"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256","name":"slot","type":"uint256","indexed":true},{"internalType":"uint256","name":"value","type":"uint256","indexed":false},{"internalType":"uint256","name":"recipient","type":"uint256","indexed":false}],"type":"event","name":"BurnSettled","anonymous"