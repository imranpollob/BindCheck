    "traversal_steps_in_order": [
      "Before any finding view, the custodian verifies every to_verify_by_custodian endpoint, snapshots each web listing, classifies whether its format is names-only, mixed, or unknown, and supplies sanitized name-only enumerations where required.",
      "Traverse every frozen audit-report backbone index completely in source_endpoints order, subject only to access failure and the total active-time budget; do not open report bodies, and preserve endpoint ID and repository URL only.",
      "Traverse every frozen contest-platform backbone index completely in source_endpoints order, subject only to access failure and the total active-time budget; do not open findings, and preserve endpoint ID and repository URL only.",
      "Traverse the frozen advisory database index completely, subject only to access failure and the total active-time budget, using a custodian-sanitized list because advisory listings mix names and descriptions.",
      "Import the two custodian-sanitized seed enumerations, tagging seed_snark_sok or seed_0xparc before deduplication.",
      "After the family reservation is complete, human screeners traverse only non-reserved families; agents never screen reserved families.",
      "Run mechanism-keyword queries only as a supplement, preserve result rank and exact query, apply the approved supplemental-only cap and irrelevant-page stop, and tag overlap with all discovery routes.",
      "Deduplicate sources and findings under the protocol while preserving unresolved matches and every discovery tag.",
      "If a selected audit report contributes any reported percentage, human screeners inventory and screen every finding in that report."
    ],
    "mechanism_keyword_groups": [
      {
        "id": "kw-proof-boundary",
        "terms": ["public input", "public output", "public signal", "binding", "underconstrained", "unconstrained", "verifier", "verification key", "program ID", "circuit ID", "calldata"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-context-occurrence",
        "terms": ["nullifier", "replay", "domain separation", "chain ID", "application ID", "asset ID", "state root", "single use", "double spend"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-effect",
        "terms": ["recipient", "beneficiary", "amount", "withdraw", "mint", "transfer", "settlement", "fee", "omission", "failed transfer"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-representation",
        "terms": ["encoding", "decoding", "ordering", "field", "range", "canonical", "truncation", "padding", "length", "prefix", "activation"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      }
    ],
    "maximum_results_per_endpoint": {
      "status": "APPROVED",
      "value": 100,
      "unit": "returned results per supplemental keyword endpoint",
      "justification": "A first-100 cap bounds each supplemental query while backbone indexes remain complete-traversal endpoints and selected audit reports remain subject to the all-findings rule.",
      "approved_by_planner_review_ids": [
        "D1P-C04-FREEZE-CODEX-ASTRA-6-2026-10-27",
        "D1P-C04-FREEZE-CLAUDE-OPUS-5.5-2026-10-27"
      ],
      "applies_to_endpoint_tiers": [
        "supplemental_keyword_query"
      ]
    },
    "active_time_budget_minutes": {
      "status": "APPROVED",
      "value": 1200,
      "unit": "active human or agent minutes across all endpoints",
      "justification": "Twenty active hours bounds the broad multi-index traversal while allowing failures, inaccessible endpoints, and truncation to be logged rather than hidden.",
      "approved_by_planner_review_ids": [
        "D1P-C04-FREEZE-CODEX-ASTRA-6-2026-10-27",
        "D1P-C04-FREEZE-CLAUDE-OPUS-5.5-2026-10-27"
      ],
      "applies_to_endpoint_tiers": [
        "seed",
        "backbone_index",
        "supplemental_keyword_query"
      ]
    },
    "consecutive_irrelevant_pages_stop": {
      "status": "APPROVED",
      "value": 3,
      "unit": "consecutive fully triaged pages per supplemental keyword endpoint",
      "justification": "Three supplemental-query pages with no result inside the broad proof-consuming-ZK inclusion scope provide a bounded stop independent of taxonomy support or desired positive findings; the rule never applies to backbone indexes.",
      "approved_by_planner_review_ids": [
        "D1P-C04-FREEZE-CODEX-ASTRA-6-2026-10-27",
        "D1P-C04-FREEZE-CLAUDE-OPUS-5.5-2026-10-27"
      ],
      "applies_to_endpoint_tiers": [
        "supplemental_keyword_query"
      ]
    },
    "pagination_policy": "Traverse each endpoint in its native stable order and record every page/cursor and result rank. Traverse every frozen backbone index completely unless access fails or the 1,200-minute total budget is exhausted. Apply the 100-result cap and three-consecutive-irrelevant-page threshold only to supplemental keyword endpoints. For every incomplete endpoint record the last cursor/page and remaining coverage where known; log inaccessible or dynamic pagination exactly. No cap truncates findings inside a selected audit report.",
    "backbone_traversal_rule": "complete_frozen_indexes_subject_to_total_budget_and_access_failure",
    "incomplete_endpoint_recording": {
      "last_position": "record_last_cursor_or_page",
      "remaining_coverage": "record_where_known_else_unknown",
      "relevance_definition": "broad_inclusion_scope_not_taxonomy_support",
      "absence_claim": "stopping_rule_does_not_establish_absence"
    },
    "stop_rule": "Backbone indexes stop only at exhaustion, exact access failure, or exhaustion of the approved total budget. Supplemental keyword endpoints may additionally stop at 100 returned results or after three consecutive fully triaged pages with no result inside the broad proof-consuming-ZK inclusion scope. Irrelevant never means failure to support the taxonomy or a preferred mechanism. Never stop because enough positive findings were found, and never interpret any stopping rule as evidence that findings are absent. Finish all findings in any selected audit report used for percentages.",
    "audit_report_completeness_rule": "screen_all_findings_in_any_selected_audit_report_used_for_percentages",
    "discovery_route_rule": "tag_seed_and_systematic_routes_before_deduplication_and_preserve_all_overlap_tags",
    "candidate_list_rule": "output_only_application_or_project_name_repository_url_and_endpoint_id; mixed-description listings require human sanitization",
    "content_access_rule": "planning_agents_must_not_open_or_read_findings_report_bodies_or_bug_descriptions"
  }
}
