    "traversal_steps_in_order": [
      "Before any finding view, the custodian verifies every to_verify_by_custodian endpoint, snapshots each web listing, classifies whether its format is names-only, mixed, or unknown, and supplies sanitized name-only enumerations where required.",
      "Enumerate names from audit-report backbone indexes in the source_endpoints order without opening report bodies; preserve endpoint ID and repository URL only.",
      "Enumerate names from contest-platform backbone indexes in the source_endpoints order without opening findings; preserve endpoint ID and repository URL only.",
      "Enumerate names from the advisory database only from a custodian-sanitized list because advisory listings mix names and descriptions.",
      "Import the two custodian-sanitized seed enumerations, tagging seed_snark_sok or seed_0xparc before deduplication.",
      "After the family reservation is complete, human screeners traverse only non-reserved families; agents never screen reserved families.",
      "Run mechanism-keyword queries only as a supplement, preserve result rank and exact query, and tag overlap with all discovery routes.",
      "Deduplicate sources and findings under the protocol while preserving unresolved matches and every discovery tag.",
      "If a selected audit report contributes any reported percentage, human screeners inventory and screen every finding in that report."
    ],
    "mechanism_keyword_groups": [
      {
        "id": "kw-proof-boundary",
        "terms": ["public input", "public output", "public signal", "binding", "underconstrained", "unconstrained", "verifier", "verification key", "program ID", "circuit ID", "calldata"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-context-occurrence",
        "terms": ["nullifier", "replay", "domain separation", "chain ID", "application ID", "asset ID", "state root", "single use", "double spend"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-effect",
        "terms": ["recipient", "beneficiary", "amount", "withdraw", "mint", "transfer", "settlement", "fee", "omission", "failed transfer"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      },
      {
        "id": "kw-representation",
        "terms": ["encoding", "decoding", "ordering", "field", "range", "canonical", "truncation", "padding", "length", "prefix", "activation"],
        "role": "supplement_only",
        "applies_to_endpoint_ids": ["supplemental-github-search", "supplemental-web-search"]
      }
    ],
    "maximum_results_per_endpoint": {
      "status": "PROPOSED",
      "value": 100,
      "unit": "index entries or query results",
      "justification": "A uniform first-100 cap bounds source dominance while retaining a substantial returned-order slice; once an audit report is selected, the all-findings rule overrides this cap inside that report.",
      "approved_by_planner_review_ids": []
    },
    "active_time_budget_minutes": {
      "status": "PROPOSED",
      "value": 1200,
      "unit": "active human or agent minutes across all endpoints",
      "justification": "Twenty active hours bounds the broad multi-index traversal while allowing failures, inaccessible endpoints, and truncation to be logged rather than hidden.",
      "approved_by_planner_review_ids": []
    },
    "consecutive_irrelevant_pages_stop": {
      "status": "PROPOSED",
      "value": 3,
      "unit": "consecutive fully triaged index pages",
      "justification": "Three consecutive pages with no eligible proof-consuming ZK project provides a source-local saturation signal without stopping after a desired positive count.",
      "approved_by_planner_review_ids": []
    },
    "pagination_policy": "Traverse each endpoint in its native stable order. Record every page/cursor and result rank. Continue until exhaustion, the endpoint result cap, the total active-time budget, or the approved consecutive-irrelevant-page rule; inaccessible or dynamic pagination is logged. The cap applies to index/query retrieval, not to findings inside a selected audit report.",
    "stop_rule": "Stop an endpoint only at exhaustion, the approved per-endpoint cap, the approved consecutive-irrelevant-page threshold, an exact access failure, or exhaustion of the approved total budget. Never stop because enough positive findings were found. Finish all findings in any selected audit report used for percentages.",
    "audit_report_completeness_rule": "screen_all_findings_in_any_selected_audit_report_used_for_percentages",
    "discovery_route_rule": "tag_seed_and_systematic_routes_before_deduplication_and_preserve_all_overlap_tags",
    "candidate_list_rule": "output_only_application_or_project_name_repository_url_and_endpoint_id; mixed-description listings require human sanitization",
    "content_access_rule": "planning_agents_must_not_open_or_read_findings_report_bodies_or_bug_descriptions"
  }
}
