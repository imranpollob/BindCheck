digraph proposal {

graph [bgcolor="white", pad="0.15", nodesep="0.32", ranksep="0.40", splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#F5F6F7", color="#6B7785", fontname="Liberation Sans", fontsize=16, fontcolor="#17212B", margin="0.16,0.12", penwidth=1.2];
edge [color="#526273", penwidth=1.3, arrowsize=0.7, fontname="Liberation Sans", fontsize=12, fontcolor="#334155"];

rankdir=LR;
proof [label="Proof relation\nAuthenticates intended\npayment occurrences"];
boundary [label="Correspondence obligation\nEncoding · identity · multiplicity\nReachable state · caller policy", fillcolor="#E8F0F7", color="#38678A"];
effect [label="Consumer execution\nDecodes inputs and\nchanges balances"];
proof -> boundary -> effect;

}
