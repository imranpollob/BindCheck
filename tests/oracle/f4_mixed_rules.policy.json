{
  "policy_id": "f4-mixed-rules",
  "description": "Single-use A and repeatable B have disjoint token roles; replaying B is permitted.",
  "protected_effects": [
    {
      "id": "single_A",
      "match": {
        "type": "erc20_transfer",
        "from": "0x0",
        "contract_role": "token_a"
      },
      "entitlements": [],
      "single_use": {
        "key_pub": {
          "proof": "cred",
          "index": 0
        }
      }
    },
    {
      "id": "repeatable_B",
      "match": {
        "type": "erc20_transfer",
        "from": "0x0",
        "contract_role": "token"
      },
      "entitlements": []
    }
  ]
}
