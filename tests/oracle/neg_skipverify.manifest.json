{
  "schema_version": 1,
  "case_id": "neg-skipverify",
  "safety": { "local_only": true, "fork_enabled": false },
  "source": { "kind": "local_copy", "path": "tests/oracle/synthetic" },
  "policy": "neg_skipverify.policy.json",
  "variants": [
    {
      "id": "skipverify",
      "label": "XR-02 negative control: mutated branch skips the verifier",
      "build": [ { "name": "forge_build", "cwd": "{source}", "argv": ["forge","build","--root","{source}"] } ],
      "artifacts": ["{source}/out"],
      "scenario": {
        "signers": ["deployer","holder","mallory"],
        "deploy": [
          { "name": "verifier", "artifact": "CanonicalVerifier", "args": [] },
          { "name": "token", "artifact": "MintToken", "args": [] },
          { "name": "consumer", "artifact": "SkipVerifyConsumer", "args": [ { "$addr": "verifier" }, { "$addr": "token" } ] }
        ],
        "verifier_checks": [
          { "contract": "verifier", "function": "verifyProof", "args": [
            { "$proofPart": { "proof": "cred", "part": "a" } },
            { "$proofPart": { "proof": "cred", "part": "b" } },
            { "$proofPart": { "proof": "cred", "part": "c" } },
            { "$pubArray": { "proof": "cred" } } ] }
        ],
        "honest_tx": {
          "target": "consumer", "function": "claim", "from": "mallory",
          "args": [
            { "name": "a", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "a" } } },
            { "name": "b", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "b" } } },
            { "name": "c", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "c" } } },
            { "name": "pub", "class": "pub", "value": { "$pubArray": { "proof": "cred" } } },
            { "name": "recipient", "class": "bound", "value": { "$pubAsAddress": { "proof": "cred", "index": 1 } } },
            { "name": "skipVerify", "class": "free", "value": { "$lit": false } }
          ]
        },
        "operators": ["FREE_ARG"],
        "free_args": { "skipVerify": { "mutation": { "$lit": true } } },
        "proofs": { "cred": { "proof": "{source}/fixtures/cred-proof.json", "public": "{source}/fixtures/cred-public.json" } }
      }
    }
  ]
}
