{
  "schema_version": 1,
  "case_id": "synthetic-obligation",
  "safety": {
    "local_only": true,
    "fork_enabled": false
  },
  "source": {
    "kind": "local_copy",
    "path": "tests/oracle/synthetic"
  },
  "policy": "obligation.policy.json",
  "variants": [
    {
      "id": "vulnerable",
      "label": "obligation control: fee gated by a free flag (vulnerable)",
      "build": [
        {
          "name": "forge_build",
          "cwd": "{source}",
          "argv": ["forge", "build", "--root", "{source}"]
        }
      ],
      "artifacts": ["{source}/out"],
      "scenario": {
        "signers": ["deployer", "holder", "mallory", "treasury"],
        "deploy": [
          { "name": "verifier", "artifact": "CanonicalVerifier", "args": [] },
          { "name": "reward", "artifact": "MintToken", "args": [] },
          { "name": "fee", "artifact": "MintToken", "args": [] },
          {
            "name": "consumer",
            "artifact": "ObligationConsumerVulnerable",
            "args": [
              { "$addr": "verifier" },
              { "$addr": "reward" },
              { "$addr": "fee" },
              { "$signer": "treasury" }
            ]
          }
        ],
        "verifier_checks": [
          {
            "contract": "verifier",
            "function": "verifyProof",
            "args": [
              { "$proofPart": { "proof": "cred", "part": "a" } },
              { "$proofPart": { "proof": "cred", "part": "b" } },
              { "$proofPart": { "proof": "cred", "part": "c" } },
              { "$pubArray": { "proof": "cred" } }
            ]
          }
        ],
        "honest_tx": {
          "target": "consumer",
          "function": "claim",
          "from": "holder",
          "args": [
            { "name": "a", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "a" } } },
            { "name": "b", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "b" } } },
            { "name": "c", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "c" } } },
            { "name": "pub", "class": "pub", "value": { "$pubArray": { "proof": "cred" } } },
            { "name": "recipient", "class": "bound", "value": { "$pubAsAddress": { "proof": "cred", "index": 1 } } },
            { "name": "skipFee", "class": "free", "value": { "$lit": false } }
          ]
        },
        "operators": ["CALLER", "FREE_ARG", "ALIAS", "REPLAY", "DOMAIN"],
        "free_args": {
          "skipFee": { "mutation": { "$lit": true } }
        },
        "alias": {
          "arg": "pub",
          "proof": "cred",
          "positions": [0, 1]
        },
        "caller_candidates": ["mallory"],
        "domain": {
          "redeploy": ["verifier", "reward", "fee", "consumer"]
        },
        "proofs": {
          "cred": {
            "proof": "{source}/fixtures/cred-proof.json",
            "public": "{source}/fixtures/cred-public.json"
          }
        },
        "initial_state": [
          {
            "target": "reward",
            "function": "mint",
            "from": "deployer",
            "args": [{ "$signer": "deployer" }, { "$uint": "500000" }]
          }
        ]
      }
    },
    {
      "id": "bound",
      "label": "obligation control: fee always discharged (correctly bound)",
      "build": [
        {
          "name": "forge_build",
          "cwd": "{source}",
          "argv": ["forge", "build", "--root", "{source}"]
        }
      ],
      "artifacts": ["{source}/out"],
      "scenario": {
        "signers": ["deployer", "holder", "mallory", "treasury"],
        "deploy": [
          { "name": "verifier", "artifact": "CanonicalVerifier", "args": [] },
          { "name": "reward", "artifact": "MintToken", "args": [] },
          { "name": "fee", "artifact": "MintToken", "args": [] },
          {
            "name": "consumer",
            "artifact": "ObligationConsumerFixed",
            "args": [
              { "$addr": "verifier" },
              { "$addr": "reward" },
              { "$addr": "fee" },
              { "$signer": "treasury" }
            ]
          }
        ],
        "verifier_checks": [
          {
            "contract": "verifier",
            "function": "verifyProof",
            "args": [
              { "$proofPart": { "proof": "cred", "part": "a" } },
              { "$proofPart": { "proof": "cred", "part": "b" } },
              { "$proofPart": { "proof": "cred", "part": "c" } },
              { "$pubArray": { "proof": "cred" } }
            ]
          }
        ],
        "honest_tx": {
          "target": "consumer",
          "function": "claim",
          "from": "holder",
          "args": [
            { "name": "a", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "a" } } },
            { "name": "b", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "b" } } },
            { "name": "c", "class": "proof", "value": { "$proofPart": { "proof": "cred", "part": "c" } } },
            { "name": "pub", "class": "pub", "value": { "$pubArray": { "proof": "cred" } } },
            { "name": "recipient", "class": "bound", "value": { "$pubAsAddress": { "proof": "cred", "index": 1 } } },
            { "name": "skipFee", "class": "free", "value": { "$lit": false } }
          ]
        },
        "operators": ["CALLER", "FREE_ARG", "ALIAS", "REPLAY", "DOMAIN"],
        "free_args": {
          "skipFee": { "mutation": { "$lit": true } }
        },
        "alias": {
          "arg": "pub",
          "proof": "cred",
          "positions": [0, 1]
        },
        "caller_candidates": ["mallory"],
        "domain": {
          "redeploy": ["verifier", "reward", "fee", "consumer"]
        },
        "proofs": {
          "cred": {
            "proof": "{source}/fixtures/cred-proof.json",
            "public": "{source}/fixtures/cred-public.json"
          }
        },
        "initial_state": [
          {
            "target": "reward",
            "function": "mint",
            "from": "deployer",
            "args": [{ "$signer": "deployer" }, { "$uint": "500000" }]
          }
        ]
      }
    }
  ]
}
