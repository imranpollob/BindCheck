  },
  "policy": "policy.json",
  "prepare": [
    {
      "name": "00_mkdir",
      "cwd": "{out}",
      "argv": [
        "mkdir",
        "-p",
        "{out}/proofs",
        "{out}/circuit-build/age",
        "{out}/circuit-build/kyc"
      ]
    },
    {
      "name": "10_npm_ci",
      "cwd": "{work}/source",
      "argv": [
        "npm",
        "ci",
        "--no-audit",
        "--no-fund"
      ]
    },
    {
      "name": "10b_deps",
      "cwd": "{work}/source",
      "argv": [
        "npm",
        "install",
        "--no-save",
        "--package-lock=false",
        "--no-audit",
        "--no-fund",
        "circomlibjs@0.1.7",
        "@openzeppelin/contracts@5.0.2"
      ]
    },
    {
      "name": "11_link_circomlib",
      "cwd": "{work}/source",
      "argv": [
        "bash",
        "-lc",
        "if [ -d circuits/circomlib ] && [ ! -L circuits/circomlib ]; then rmdir circuits/circomlib; ln -s \"$PWD/node_modules/circomlib\" circuits/circomlib; fi"
      ]
    }
  ],
  "proof": [
    {
      "name": "20_make_inputs",
      "cwd": "{work}/source",
      "argv": [
        "node",
        "{ROOT}/findings/racepass/make_inputs.js",
        "{out}/proofs"
      ],
      "env": {
        "NODE_PATH": "{work}/source/node_modules"
      }
    },
    {
      "name": "21_age_compile",
      "cwd": "{work}/source",
      "argv": [
        "{BC}/bindcheck-zk/tools/circom-2.1.9/target/release/circom",
        "{work}/source/circuits/age_proof/age_check.circom",
        "--r1cs",
        "--wasm",
        "--sym",
        "-o",
        "{out}/circuit-build/age"
      ]
    },
    {
      "name": "22_age_fullprove",
      "cwd": "{work}/source",
