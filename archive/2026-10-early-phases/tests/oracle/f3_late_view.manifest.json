{
  "schema_version": 1,
  "case_id": "f3-late-view",
  "safety": {
    "local_only": true,
    "fork_enabled": false
  },
  "source": {
    "kind": "local_copy",
    "path": "tests/oracle/synthetic"
  },
  "policy": "f3_late_view.policy.json",
  "variants": [
    {
      "id": "late_view",
      "label": "XR-02 negative control: mutated branch skips the verifier",
      "build": [
        {
          "name": "forge_build",
          "cwd": "{source}",
          "argv": [
            "forge",
            "build",
            "--root",
            "{source}"
          ]
        }
      ],
      "artifacts": [
        "{source}/out"
      ],
      "scenario": {
        "signers": [
          "deployer",
          "holder",
          "mallory"
        ],
        "deploy": [
          {
            "name": "verifier",
            "artifact": "CanonicalVerifier",
            "args": []
          },
          {
            "name": "consumer",
            "artifact": "LateReadableCounters",
            "args": [
              {
                "$addr": "verifier"
              }
            ]
          }
        ],
        "verifier_checks": [
          {
            "contract": "verifier",
            "function": "verifyProof",
            "args": [
              {
                "$proofPart": {
                  "proof": "cred",
                  "part": "a"
                }
              },
              {
                "$proofPart": {
                  "proof": "cred",
                  "part": "b"
                }
              },
              {
                "$proofPart": {
                  "proof": "cred",
                  "part": "c"
                }
              },
              {
                "$pubArray": {
                  "proof": "cred"
                }
              }
            ]
          }
        ],
        "honest_tx": {
          "target": "consumer",
          "function": "claim",
          "from": "mallory",
          "args": [
            {
              "name": "a",
              "class": "proof",
              "value": {
                "$proofPart": {
                  "proof": "cred",
                  "part": "a"
                }
              }
            },
            {
              "name": "b",
              "class": "proof",
              "value": {
                "$proofPart": {
                  "proof": "cred",
                  "part": "b"
                }
              }
            },
            {
              "name": "c",
              "class": "proof",
              "value": {
                "$proofPart": {
                  "proof": "cred",
                  "part": "c"
                }
              }
            },
            {
              "name": "pub",
              "class": "pub",
              "value": {
                "$pubArray": {
                  "proof": "cred"
                }
              }
            },
            {
              "name": "omitBacking",
              "class": "free",
              "value": {
                "$lit": false
              }
            }
          ]
        },
        "operators": [
          "FREE_ARG"
        ],
        "proofs": {
          "cred": {
            "proof": "{source}/fixtures/cred-proof.json",
            "public": "{source}/fixtures/cred-public.json"
          }
        },
        "state_views": [
          {
            "name": "credit",
            "contract": "consumer",
            "function": "totalCredit"
          },
          {
            "name": "backing",
            "contract": "consumer",
            "function": "settledBacking"
          }
        ],
        "free_args": {
          "omitBacking": {
            "mutation": {
              "$lit": true
            }
          }
        }
      }
    }
  ]
}
